{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decidetobecow",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-15",
  "build": {
    "command": "npm run check"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
